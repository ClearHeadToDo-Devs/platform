# Sourced by the agent sandbox (agents/session) in the clone's root before
# each session, and by agent-land before .sandbox/gate. Builds the
# clearhead CLI from this branch and puts it first on PATH, so agents use the
# branch's CLI and never an installed copy. Cargo's registry and one build
# directory shared by this repository's workspaces, and uv's cache (pyshacl for
# the graph shapes check), live in the sandbox's cache.
export CARGO_HOME=/srv/cache/cargo CARGO_TARGET_DIR=/srv/cache/target UV_CACHE_DIR=/srv/cache/uv
cargo build -q --manifest-path clearhead-core/Cargo.toml -p clearhead
export PATH="$CARGO_TARGET_DIR/debug:$PATH"
# A fresh clone has no node_modules; the grammar's gate needs them. Which
# dependencies may run install scripts is tree-sitter-actions' allowScripts.
# A read-only session (a review) cannot write them, and runs no gate.
[ -d tree-sitter-actions/node_modules ] || [ ! -w tree-sitter-actions ] ||
    (cd tree-sitter-actions && npm ci --no-audit --no-fund --loglevel=error)
