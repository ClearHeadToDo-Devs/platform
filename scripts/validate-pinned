#!/bin/sh
# Validate the exact submodule revisions staged by the platform repository by
# delegating to each repository's own pre-push gate.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

status=$(git submodule status --recursive)
if printf '%s\n' "$status" | grep -Eq '^[+-U]'; then
    echo "validate-pinned > submodules do not match the platform gitlinks:" >&2
    printf '%s\n' "$status" >&2
    exit 1
fi

for repo in tree-sitter-actions clearhead-core \
    clearhead.nvim ontology specifications
do
    if test -n "$(git -C "$repo" status --porcelain)"; then
        echo "validate-pinned > $repo has uncommitted changes" >&2
        exit 1
    fi
done

echo "validate-pinned > submodules are clean and match the platform gitlinks"

run_gate() {
    repo=$1
    echo "validate-pinned > $repo"
    (
        cd "$root/$repo"
        ./.githooks/pre-push </dev/null
    )
}

# clearhead-core is one Cargo workspace: its pre-push gate covers the Core,
# native adapter, CLI, and LSP together. That repository-owned gate also proves
# the pure boundary with its source-capability and wasm dependency checks; do
# not duplicate weaker path greps here.
run_gate tree-sitter-actions
run_gate clearhead-core
# clearhead.nvim's parser specs run against the pinned grammar, never a parser
# installed on this machine: build it into a private XDG data directory.
(
    nvim_data=$(mktemp -d)
    trap 'rm -rf "$nvim_data"' EXIT
    mkdir -p "$nvim_data/nvim/site/parser"
    (cd "$root/tree-sitter-actions" &&
        ./node_modules/.bin/tree-sitter build -o "$nvim_data/nvim/site/parser/actions.so")
    export XDG_DATA_HOME="$nvim_data"
    run_gate clearhead.nvim
)
run_gate ontology

# Specifications owns no runnable gate of its own — it is inert oracle data.
# Conformance is the implementations' responsibility, so it is checked here in
# the pinned composition. Core consumes the semantic corpus through its opt-in
# feature; the schema also validates both the spec's canonical JSON example and
# the pinned CLI's projection of a real workspace.
echo "validate-pinned > Core DSL conformance"
(
    cd "$root/clearhead-core"
    CLEARHEAD_SPEC_DIR="$root/specifications" \
        cargo test -p clearhead_core --features spec-conformance --test spec_conformance
)

# The index family moved into the CLI's in-process sparql layer when graphd was
# retired, so its index_query_result schema conformance is proven at the new
# producer boundary: the CLI's own spec-conformance test.
echo "validate-pinned > CLI index query-output conformance"
(
    cd "$root/clearhead-core/crates/clearhead-cli"
    CLEARHEAD_SPEC_DIR="$root/specifications" \
        cargo test --features spec-conformance --test spec_conformance
)

# The pinned CLI, which the checks below run. Never one on PATH: that one was
# built from some other revision.
cargo build -q --manifest-path "$root/clearhead-core/crates/clearhead-cli/Cargo.toml"
clearhead="${CARGO_TARGET_DIR:-$root/clearhead-core/target}/debug/clearhead"

# Engine-independence (rdf-publication external-rdf-proof): export the fixture
# workspace with the real binary and answer the CLI's saved .sparql in rdflib, a
# wholly independent SPARQL engine. Proves the publication is standard RDF, not
# an Oxigraph-shaped artifact. rdflib rides in the ontology venv the ontology
# gate already provisions.
echo "validate-pinned > RDF publication is engine-independent"
if test -x "$root/ontology/.venv/bin/python"; then
    proof_python="$root/ontology/.venv/bin/python"
else
    proof_python=python3
fi
CLEARHEAD_BIN="$clearhead" "$proof_python" "$root/scripts/rdf-interop/proof.py"

echo "validate-pinned > specifications schema conformance"
# check-jsonschema comes first: a `jsonschema` on PATH may be python-jsonschema's
# deprecated CLI, which shares SourceMeta's name but not its arguments.
if command -v check-jsonschema >/dev/null 2>&1; then
    schema_validator=check-jsonschema
    schema_validator_kind=check
elif command -v jsonschema >/dev/null 2>&1 && ! jsonschema --version 2>&1 | grep -q DeprecationWarning; then
    schema_validator=jsonschema
    schema_validator_kind=sourcemeta
elif command -v jv >/dev/null 2>&1; then
    schema_validator=jv
    schema_validator_kind=jv
elif test -x "$HOME/go/bin/jv"; then
    schema_validator="$HOME/go/bin/jv"
    schema_validator_kind=jv
else
    echo "validate-pinned > no JSON Schema CLI found; install check-jsonschema, SourceMeta jsonschema or santhosh-tekuri jv" >&2
    exit 1
fi

validate_schema() {
    schema=$1
    instance=$2
    if test "$schema_validator_kind" = check; then
        "$schema_validator" --schemafile "$schema" "$instance"
    elif test "$schema_validator_kind" = sourcemeta; then
        "$schema_validator" validate "$schema" "$instance"
    else
        "$schema_validator" "$schema" "$instance"
    fi
}

# 0. Every schema's $id names one release (README, Releases): a tag, never a
#    branch. Core's stamped $schema URLs are held to these ids by its
#    spec-conformance test.
releases=$(for s in "$root"/specifications/schemas/*.json; do
    jq -r '."$id" // ""' "$s" | sed -E \
        -e 's#^https://raw\.githubusercontent\.com/ClearHeadToDo-Devs/specifications/(v[0-9]+\.[0-9]+\.[0-9]+)/schemas/[^/]+$#\1#' \
        -e 't' -e "s#.*#not a release id in ${s##*/}#"
done | sort -u)
if [ "$(printf '%s\n' "$releases" | wc -l)" -ne 1 ] || ! printf '%s' "$releases" | grep -q '^v'; then
    echo "validate-pinned > schema ids must all name one release:" >&2
    printf '%s\n' "$releases" >&2
    exit 1
fi
echo "validate-pinned > schema ids name release $releases"

schema="$root/specifications/schemas/actions.schema.json"

# 1. Spec self-consistency: the canonical example conforms to the schema.
validate_schema "$schema" "$root/specifications/examples/actions/sample.json"

# 2. Implementation conformance: the pinned CLI's canonical projection
#    (`read actions --format json`) of a real workspace — this repo — conforms.
projection=$(mktemp)
trap 'rm -f "$projection"' EXIT
(cd "$root" && "$clearhead" read actions --format json) \
    >"$projection" 2>/dev/null
validate_schema "$schema" "$projection"

# 3. Charter schema self-consistency and pinned implementation projection.
charter_schema="$root/specifications/schemas/charters.schema.json"
validate_schema "$charter_schema" "$root/specifications/examples/charters/sample.json"
(cd "$root" && "$clearhead" read charters --format json) \
    >"$projection" 2>/dev/null
validate_schema "$charter_schema" "$projection"

echo "validate-pinned > all repository-owned checks passed"
