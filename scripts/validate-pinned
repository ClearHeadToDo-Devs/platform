#!/bin/sh
# Validate the exact submodule revisions staged by the platform repository by
# delegating to each repository's own pre-push gate.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

status=$(git submodule status --recursive)
if printf '%s\n' "$status" | grep -Eq '^[+-U]'; then
    echo "validate-pinned > submodules do not match the platform gitlinks:" >&2
    printf '%s\n' "$status" >&2
    exit 1
fi

for repo in tree-sitter-actions clearhead-core clearhead-cli clearhead-graphd \
    clearhead-lsp clearhead.nvim ontology specifications
do
    if test -n "$(git -C "$repo" status --porcelain)"; then
        echo "validate-pinned > $repo has uncommitted changes" >&2
        exit 1
    fi
done

echo "validate-pinned > submodules are clean and match the platform gitlinks"

run_gate() {
    repo=$1
    echo "validate-pinned > $repo"
    (
        cd "$root/$repo"
        ./.githooks/pre-push </dev/null
    )
}

run_gate tree-sitter-actions
run_gate clearhead-core
run_gate clearhead-cli
run_gate clearhead-graphd
run_gate clearhead-lsp
run_gate clearhead.nvim
run_gate ontology

# Specifications owns no runnable gate of its own — it is inert oracle data.
# Conformance is the implementations' responsibility, so it is checked here in
# the pinned composition. Core consumes the semantic corpus through its opt-in
# feature; the schema also validates both the spec's canonical JSON example and
# the pinned CLI's projection of a real workspace.
echo "validate-pinned > Core DSL conformance"
(
    cd "$root/clearhead-core"
    CLEARHEAD_SPEC_DIR="$root/specifications" \
        cargo test --features spec-conformance --test spec_conformance
)

# graphd owns query output, so index-JSON schema conformance is proven at its
# producer boundary against the spec's published index_query_result schema.
echo "validate-pinned > graphd query-output conformance"
(
    cd "$root/clearhead-graphd"
    CLEARHEAD_SPEC_DIR="$root/specifications" \
        cargo test --features spec-conformance --test spec_conformance
)

echo "validate-pinned > specifications schema conformance"
if ! command -v jsonschema >/dev/null 2>&1; then
    echo "validate-pinned > jsonschema CLI not found; install the sourcemeta jsonschema validator" >&2
    exit 1
fi

schema="$root/specifications/schemas/actions.schema.json"

# 1. Spec self-consistency: the canonical example conforms to the schema.
jsonschema validate "$schema" "$root/specifications/examples/actions/sample.json"

# 2. Implementation conformance: the pinned CLI's canonical projection
#    (`read actions --format json`) of a real workspace — this repo — conforms.
cargo build -q --manifest-path "$root/clearhead-cli/Cargo.toml"
projection=$(mktemp)
trap 'rm -f "$projection"' EXIT
(cd "$root" && "$root/clearhead-cli/target/debug/clearhead" read actions --format json) \
    >"$projection" 2>/dev/null
jsonschema validate "$schema" "$projection"

echo "validate-pinned > all repository-owned checks passed"
