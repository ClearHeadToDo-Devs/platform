# =============================================================================
# Query: For the human
# =============================================================================
# Purpose: everything an agent is waiting on the human for: open actions
# tagged +human, in any charter and any charter state. Empty means no agent
# needs anything from you.
# Usage: clearhead query named for-human
# Returns: name, status, priority, source_file, source_line
# =============================================================================

PREFIX actions: <https://clearhead.us/vocab/actions/v4#>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ws: <https://clearhead.us/vocab/workspace/v1#>

SELECT ?name ?status ?priority ?source_file ?source_line WHERE {
    ?action a actions:Action ;
         rdfs:label ?name ;
         cco:ont00001868 ?raw_state ;
         actions:requiresContext ?context .
    ?context actions:hasContextIdentifier "human" .
    FILTER(?raw_state != actions:Completed && ?raw_state != actions:Cancelled)
    BIND(STRAFTER(STR(?raw_state), "#") AS ?status)
    OPTIONAL { ?action actions:hasPriority ?priority }
    OPTIONAL { ?action ws:hasSourceFile ?source_file ; ws:hasSourceLine ?source_line }
}
ORDER BY ?priority ?name
