#!/bin/sh
# Start Structurizr locally and publish it privately to this node's tailnet.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
compose="$root/structurizr/compose.yaml"
port=${STRUCTURIZR_PORT:-8080}
export STRUCTURIZR_UID=${STRUCTURIZR_UID:-$(id -u)}
export STRUCTURIZR_GID=${STRUCTURIZR_GID:-$(id -g)}

if ! command -v docker >/dev/null 2>&1; then
    echo "error: docker is required but is not installed" >&2
    exit 1
fi
if ! docker compose version >/dev/null 2>&1; then
    echo "error: the Docker Compose plugin is required" >&2
    exit 1
fi
if ! docker_error=$(docker info 2>&1); then
    if printf '%s\n' "$docker_error" | grep -qi 'permission denied'; then
        cat >&2 <<EOF
error: $USER cannot access the Docker daemon.
Add the user to the docker group, then disconnect and reconnect this shell:

  sudo usermod -aG docker "$USER"
EOF
    else
        printf 'error: Docker is unavailable:\n%s\n' "$docker_error" >&2
    fi
    exit 1
fi
if ! command -v tailscale >/dev/null 2>&1; then
    echo "error: tailscale is required but is not installed" >&2
    exit 1
fi
if ! tailscale status >/dev/null 2>&1; then
    echo "error: tailscale is not connected" >&2
    exit 1
fi

STRUCTURIZR_PORT="$port" docker compose -f "$compose" up -d

attempt=0
until curl -fsS "http://127.0.0.1:$port/" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 60 ]; then
        echo "error: Structurizr did not become ready on 127.0.0.1:$port" >&2
        docker compose -f "$compose" logs structurizr >&2
        exit 1
    fi
    sleep 1
done

if ! tailscale serve --bg --yes "http://127.0.0.1:$port"; then
    cat >&2 <<EOF
error: this user cannot configure Tailscale Serve.
Run this one-time host setup, then rerun this script:

  sudo tailscale set --operator=$USER
EOF
    exit 1
fi

echo
tailscale serve status
