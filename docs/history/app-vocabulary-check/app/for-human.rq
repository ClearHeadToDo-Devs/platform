PREFIX app: <https://clearhead.us/vocab/app/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Open actions whose context is "human".
SELECT ?id ?name ?state ?priority WHERE {
  ?id a app:Action ; rdfs:label ?name ; app:state ?state ; app:context/rdfs:label "human" .
  FILTER(?state NOT IN (app:Completed, app:Cancelled))
  OPTIONAL { ?id app:priority ?priority }
}
ORDER BY ?priority ?name
