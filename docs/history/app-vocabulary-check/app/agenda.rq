PREFIX app: <https://clearhead.us/vocab/app/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Open actions under fully active charters, with nothing left to wait on and
# no open children, that start today or earlier or are due by the end of today.
SELECT ?id ?name ?state ?priority WHERE {
  BIND("2026-10-05T00:00:00Z"^^xsd:dateTime AS ?endOfToday)
  ?id a app:Action ; rdfs:label ?name ; app:state ?state .
  FILTER(?state IN (app:NotStarted, app:InProgress))
  FILTER NOT EXISTS { ?id app:partOf+ ?charter . ?charter a app:Charter ; app:state ?charter_state . FILTER(?charter_state != app:Active) }
  FILTER NOT EXISTS { ?id app:waitsOn/app:state ?wait_state . FILTER(?wait_state NOT IN (app:Completed, app:Cancelled)) }
  FILTER NOT EXISTS { ?child app:partOf ?id ; app:state ?child_state . FILTER(?child_state NOT IN (app:Completed, app:Cancelled)) }
  OPTIONAL { ?id app:notBefore ?start }
  OPTIONAL { ?id app:lateFrom ?late }
  FILTER(?start < ?endOfToday || ?late <= ?endOfToday)
  OPTIONAL { ?id app:priority ?priority }
}
ORDER BY ?state COALESCE(?priority, 99) ?name
